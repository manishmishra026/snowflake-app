# =============================================================================
# Active Authentication Flow (service-principal | user-auth | service-account)
# =============================================================================
SNOWFLAKE_AUTH_FLOW=service-principal

# =============================================================================
# Service Principal Flow (Required)
# =============================================================================

# Azure AD Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your-account-id
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_APPLICATION_ID_URI=https://your-account.snowflakecomputing.com

# Snowflake (Optional)
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_ROLE=your-role

# =============================================================================
# User Authentication / OBO Flow (Optional — for /tables-as-user endpoint)
# =============================================================================

# Azure AD Configuration for User Auth
USER_AUTH_AZURE_TENANT_ID=your-tenant-id
USER_AUTH_AZURE_CLIENT_ID=your-client-id
USER_AUTH_AZURE_CLIENT_SECRET=your-client-secret
USER_AUTH_AZURE_AUDIENCE=api://your-app-uri

# Snowflake Configuration for User Auth
USER_AUTH_SNOWFLAKE_ACCOUNT=your-account-id
USER_AUTH_SNOWFLAKE_DATABASE=your-database
USER_AUTH_SNOWFLAKE_APPLICATION_ID_URI=https://your-account.snowflakecomputing.com

# Snowflake (Optional) for User Auth
USER_AUTH_SNOWFLAKE_SCHEMA=PUBLIC
USER_AUTH_SNOWFLAKE_WAREHOUSE=your-warehouse
USER_AUTH_SNOWFLAKE_ROLE=your-role

# =============================================================================
# Application Settings (Optional)
# =============================================================================

# ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# ENV=development
# LOG_LEVEL=INFO

# =============================================================================
# Service Account Flow (Optional — for /tables-as-service-account endpoint)
# =============================================================================
SNOWFLAKE_SERVICE_ACCOUNT_USER=webapp_user
SNOWFLAKE_SERVICE_ACCOUNT_PASSWORD=your-service-account-password
SNOWFLAKE_SERVICE_ACCOUNT_ROLE=WEBAPP_READER_ROLE

# =============================================================================
# Azure Application Insights Configuration (Optional)
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-key;IngestionEndpoint=https://..."
