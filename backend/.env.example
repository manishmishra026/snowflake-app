# =============================================================================
# Azure AD Client Token Validation (Option 1)
# =============================================================================
AZURE_TENANT_ID=your-azure-tenant-id
BACKEND_API_CLIENT_ID=your-backend-api-app-registration-client-id
WEB_APP_CLIENT_ID=your-frontend-web-app-registration-client-id
ALLOWED_CLIENT_IDS=your-frontend-web-app-client-id,your-other-backend-client-id

# =============================================================================
# Snowflake Connection Parameters (Service Account Only)
# =============================================================================
SNOWFLAKE_ACCOUNT=your-snowflake-account-identifier
SNOWFLAKE_DATABASE=your-database-name
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=your-warehouse-name
SNOWFLAKE_ROLE=your-snowflake-role-name

SNOWFLAKE_SERVICE_ACCOUNT_USER=webapp_user
SNOWFLAKE_SERVICE_ACCOUNT_PASSWORD=your-service-account-password
SNOWFLAKE_SERVICE_ACCOUNT_ROLE=WEBAPP_READER_ROLE

# =============================================================================
# Azure Application Insights Configuration (Optional)
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-guid;IngestionEndpoint=https://..."

# =============================================================================
# Application Settings (Optional)
# =============================================================================
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
ENV=development
LOG_LEVEL=INFO
